class Solution {
public:
    int myAtoi(string s) {
        int i =0;
        int n =s.size();
        long long final =0;
        int sign=1;
        while (i< n&& s[i]==' '){
            i++;
        }
        if(i<n&&(s[i]=='-'||s[i]=='+')){
            if(s[i]=='-') sign=-1;
            i++;
        }
        while(i<n){
            if(s[i]>='0'&&s[i]<='9'){
                if(final<=INT_MAX){
                    int j = s[i]-'0';
                    final =final*10+j;
                    i++;
                }
                else break;
            }
            else break;
       }
       final*= sign;
          if (final < INT_MIN)
            return INT_MIN;

        if (final > INT_MAX)
            return INT_MAX;
       return final;

    }
};
